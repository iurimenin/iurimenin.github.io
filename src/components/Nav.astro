---
import { CONTENT, SITE, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = CONTENT[lang];

const links = [
  { href: '#about', label: t.nav.about },
  { href: '#experience', label: t.nav.experience },
  { href: '#projects', label: t.nav.projects },
  { href: '#education', label: t.nav.education },
  { href: '#contact', label: t.nav.contact },
];

const initials = SITE.name
  .split(' ')
  .map((n) => n[0])
  .join('');

const menuLabel = lang === 'pt' ? 'Menu' : 'Menu';
const navLabel = lang === 'pt' ? 'Navegação principal' : 'Main navigation';
---

<header class="nav">
  <div class="nav-inner wrap">
    <a class="brand" href={lang === 'pt' ? '/pt/' : '/'} aria-label={SITE.name}>
      <span class="brand-mark">{initials}</span>
      <span class="brand-name">{SITE.name}</span>
    </a>

    <nav class="nav-links" aria-label={navLabel}>
      {
        links.map((l) => (
          <a href={l.href} data-nav-link>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-right">
      <a
        class="lang-switch"
        href={t.langSwitch.to}
        title={t.langSwitch.title}
        hreflang={lang === 'pt' ? 'en' : 'pt-BR'}
      >
        {t.langSwitch.label}
      </a>

      {/* Menu mobile em <details>: abre e fecha sem JS. */}
      <details class="menu">
        <summary aria-label={menuLabel}>
          <span class="bars" aria-hidden="true"></span>
        </summary>
        <nav class="menu-panel" aria-label={navLabel}>
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Fecha o menu ao escolher uma seção ou ao apertar Esc — <details> sozinho
  // ficaria aberto por cima do conteúdo.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');

  if (menu) {
    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        menu.open = false;
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') menu.open = false;
    });

    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav.is-stuck {
    border-bottom-color: var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 7px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .nav-links {
    display: none;
    gap: 1.75rem;
    font-size: 0.9rem;
  }

  .nav-links a {
    position: relative;
    color: var(--text-muted);
    transition: color 0.18s ease;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.45rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a.is-active {
    color: var(--text);
  }

  .nav-links a:hover::after,
  .nav-links a.is-active::after {
    transform: scaleX(1);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lang-switch {
    display: inline-grid;
    place-items: center;
    min-width: 2.4rem;
    height: 2.25rem;
    padding-inline: 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .lang-switch:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ── Menu mobile ──────────────────────────────────────────────────────── */
  .menu {
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    background: var(--surface);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 15px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--text-muted);
    transition: transform 0.2s ease;
  }

  /* `relative` é obrigatório: sem ele os dois traços se posicionam contra o
     .menu e vão parar no canto do cabeçalho. */
  .bars {
    position: relative;
  }

  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .bars::before {
    transform: translateY(-5px);
  }

  .bars::after {
    transform: translateY(5px);
  }

  .menu[open] .bars {
    background: transparent;
  }

  .menu[open] .bars::before {
    transform: rotate(45deg);
  }

  .menu[open] .bars::after {
    transform: rotate(-45deg);
  }

  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.65rem);
    display: grid;
    min-width: 11rem;
    padding: 0.4rem;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
  }

  .menu-panel a {
    padding: 0.6rem 0.75rem;
    border-radius: 6px;
    font-size: 0.9rem;
    color: var(--text-muted);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .menu-panel a:hover {
    background: var(--bg-soft);
    color: var(--accent);
  }

  @media (max-width: 620px) {
    .brand-name {
      display: none;
    }
  }

  @media (min-width: 860px) {
    .nav-links {
      display: flex;
    }

    .menu {
      display: none;
    }
  }
</style>
