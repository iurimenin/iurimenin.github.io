---
import { CONTENT, SITE, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = CONTENT[lang];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <p>© {year} {SITE.name}. {t.footer.rights}</p>
    <p class="built">
      {t.footer.built} ·
      <a href="https://github.com/iurimenin/iurimenin.github.io" target="_blank" rel="noopener noreferrer">
        source
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 2rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  .built {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .built a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
