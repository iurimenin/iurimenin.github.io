---
import { CONTENT, SITE, SOCIALS, type Lang } from '../data/content';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = CONTENT[lang];
const initials = SITE.name
  .split(' ')
  .map((n) => n[0])
  .join('');
---

<section class="hero" id="top">
  <div class="glow" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <div class="hero-text">
      <p class="eyebrow">{t.hero.role}</p>

      <h1>
        {SITE.name}
        <span class="headline">{t.hero.headline}</span>
      </h1>

      <p class="lede tagline">{t.hero.tagline}</p>

      <ul class="facts">
        <li>
          <Icon name="pin" size={15} />
          {SITE.location[lang]}
        </li>
        <li>
          <Icon name="globe" size={15} />
          {t.hero.yearsLabel}
        </li>
      </ul>

      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${SITE.email}`}>
          <Icon name="mail" size={17} />
          {t.hero.ctaPrimary}
        </a>
        <a class="btn btn-ghost" href="#experience">
          <Icon name="arrowDown" size={17} />
          {t.hero.ctaSecondary}
        </a>
      </div>

      <ul class="socials">
        {
          SOCIALS.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="me noopener noreferrer" aria-label={s.name} title={s.name}>
                <Icon name={s.icon} size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="portrait">
      <img src={SITE.avatar} alt={SITE.name} width="320" height="320" loading="eager" onerror="this.remove()" />
      <span class="portrait-fallback" aria-hidden="true">{initials}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(4rem, 10vw, 7rem);
    overflow: hidden;
  }

  .glow {
    position: absolute;
    top: -34%;
    left: 50%;
    width: min(900px, 130vw);
    aspect-ratio: 1;
    transform: translateX(-50%);
    background: radial-gradient(circle, var(--accent-glow), transparent 62%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-block: 1rem 1.25rem;
    font-size: clamp(2.1rem, 6.5vw, 3.4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .headline {
    font-size: clamp(1.15rem, 3.2vw, 1.65rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text-muted);
  }

  .tagline {
    max-width: 46ch;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-dim);
  }

  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .facts :global(svg) {
    color: var(--accent);
    flex-shrink: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .socials {
    display: flex;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--bg-soft);
    color: var(--text-muted);
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .socials a:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    justify-self: start;
    width: clamp(140px, 34vw, 300px);
    aspect-ratio: 1;
    border-radius: 20px;
    border: 1px solid var(--border-strong);
    background: linear-gradient(150deg, var(--surface), var(--bg-soft));
    overflow: hidden;
  }

  .portrait img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: clamp(2rem, 8vw, 3.5rem);
    color: var(--accent);
    opacity: 0.55;
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr auto;
    }

    .portrait {
      justify-self: end;
    }
  }
</style>
