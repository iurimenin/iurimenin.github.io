---
import '../styles/global.css';
import { CONTENT, SITE, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = CONTENT[lang];
const canonical = new URL(lang === 'pt' ? '/pt/' : '/', Astro.site ?? SITE.url).href;
const enUrl = new URL('/', Astro.site ?? SITE.url).href;
const ptUrl = new URL('/pt/', Astro.site ?? SITE.url).href;
const ogImage = new URL('/og.png', Astro.site ?? SITE.url).href;

// JSON-LD: ajuda o Google a entender quem você é e a ligar os perfis sociais.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: canonical,
  email: `mailto:${SITE.email}`,
  jobTitle: lang === 'pt' ? 'Engenheiro de Software Full-Stack Sênior' : 'Senior Full-Stack Software Engineer',
  address: { '@type': 'PostalAddress', addressLocality: 'Vitorino', addressRegion: 'PR', addressCountry: 'BR' },
  sameAs: [
    'https://www.linkedin.com/in/iurimenin/',
    'https://github.com/iurimenin',
    'https://x.com/iuri_menin',
    'https://www.instagram.com/iurimenin/',
    'https://www.facebook.com/iurimenin',
  ],
};
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#0a0b0d" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="pt-BR" href={ptUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@iuri_menin" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <slot />

    <script>
      // Revela seções ao rolar. Se o JS falhar, o CSS `.reveal` continua
      // invisível — então marcamos tudo como visível já de cara e só então
      // ativamos a animação, para nunca esconder conteúdo de verdade.
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      }

      // Marca o link da navbar correspondente à seção visível.
      const sections = document.querySelectorAll<HTMLElement>('section[id]');
      const navLinks = new Map<string, HTMLAnchorElement>();
      document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((a) => {
        navLinks.set(a.getAttribute('href')!.replace('#', ''), a);
      });

      if (sections.length && navLinks.size && 'IntersectionObserver' in window) {
        // Guardamos quais seções cruzam a faixa e destacamos só uma — senão dois
        // links acendem juntos na fronteira entre seções.
        const visible = new Set<string>();
        const order = [...sections].map((s) => s.id);

        const spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) visible.add(entry.target.id);
              else visible.delete(entry.target.id);
            }

            const current = order.find((id) => visible.has(id));
            navLinks.forEach((link, id) => link.classList.toggle('is-active', id === current));
          },
          { rootMargin: '-45% 0px -50% 0px' },
        );
        sections.forEach((s) => spy.observe(s));
      }

      // Sombra na navbar depois que a página sai do topo.
      const header = document.querySelector('.nav');
      if (header) {
        const onScroll = () => header.classList.toggle('is-stuck', window.scrollY > 12);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
